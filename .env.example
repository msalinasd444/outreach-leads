# Copia este archivo como .env y cambia los valores. .env está en .gitignore.
# Solo lo usa docker compose en local. En Render se define DATABASE_URL
# (la de Neon, con ?sslmode=require) directamente en el panel.

POSTGRES_USER=outreach
# Usa solo letras y números: la contraseña va dentro de una URL de conexión.
POSTGRES_PASSWORD=cambiame
POSTGRES_DB=outreach

LOG_LEVEL=INFO
# Opcionales (por defecto 1 y 5):
# DB_POOL_MIN=1
# DB_POOL_MAX=5

# Groq. La clave se crea en console.groq.com; nunca la subas al repo.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
# Opcional: low, medium o high. Vacío: no se envía.
GROQ_REASONING_EFFORT=low
# Opcionales (por defecto 20 s por llamada y 15 llamadas por minuto):
# GROQ_TIMEOUT=20
# GROQ_RPM=15
# Pon false para levantar la API sin generar correos (y sin clave de Groq).
# WORKER_ACTIVO=true
